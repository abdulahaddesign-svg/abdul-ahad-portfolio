# ==============================================================================
# Abdul Ahad Portfolio — Production Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Auth (Structured Data & CMS)
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Private service role key for backend operations (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Cloudflare R2 Object Storage (High-Resolution Media & PDF Resumes)
# ------------------------------------------------------------------------------
# Obtain from Cloudflare Dashboard -> R2 Object Storage -> Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=abdul-ahad-portfolio-media

# Public Custom Domain or r2.dev domain for serving media
R2_PUBLIC_DOMAIN=https://media.abdulahad.design
NEXT_PUBLIC_R2_URL=https://media.abdulahad.design

# ------------------------------------------------------------------------------
# 3. Public Website Metadata & Canonical Domain
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://abdulahad.design
NEXT_PUBLIC_CONTACT_EMAIL=abdulahad.ofcl@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=+919150037005

# ------------------------------------------------------------------------------
# 4. Admin Security & Fallback Credentials
# ------------------------------------------------------------------------------
# Used for initial local administrator bootstrap before linking live Supabase project
ADMIN_FALLBACK_EMAIL=admin@abdulahad.design
ADMIN_FALLBACK_PASSWORD=AdminSecure2025!
